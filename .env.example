# Jira site and authentication mode: individual (API token) or company (OAuth).
JIRA_URL=https://your-domain.atlassian.net
ATLASSIAN_ACCOUNT_TYPE=individual

# Used only in individual mode.
ATLASSIAN_EMAIL=twoj.email@firma.pl
ATLASSIAN_API_TOKEN=TWOJ_API_TOKEN

# Used only in company mode. Keep secrets outside version control.
ATLASSIAN_CLIENT_ID=TWOJ_CLIENT_ID
ATLASSIAN_CLIENT_SECRET=TWOJ_CLIENT_SECRET
ATLASSIAN_REDIRECT_URI=http://localhost:81/oauth/callback
SESSION_ENCRYPTION_KEY=WYGENERUJ_32_BAJTOWY_KLUCZ_BASE64URL

# Available interface languages and the default language.
APP_LOCALES=pl,en,de,cs,sk,fr
APP_DEFAULT_LOCALE=pl
APP_LOCALE_COOKIE_NAME=jira_timetracker_locale
APP_LOCALE_COOKIE_TTL=31536000

# Monthly CSV report export. Boolean values accept true or false.
REPORT_EXPORT_ENABLED=true
REPORT_EXPORT_COLUMNS=issue,project,summary,date,minutes,comment
REPORT_EXPORT_FILENAME={username}_{year}_{month}.csv
REPORT_EXPORT_BOM=true
REPORT_EXPORT_SUMMARY_ROW='["PODSUMOWANIE","","Suma czasu pracy:","","{total_minutes}","{total_hours} godz. {total_remaining_minutes} min."]'
REPORT_EXPORT_SUMMARY_SPACER=true

# Interface variant: default or compact.
TEMPLATE=default

# Reporting workday length and an IANA timezone name.
DAILY_HOURS_LIMIT=7.5
APP_TIMEZONE=Europe/Warsaw

# Minimum logging level emitted by the application, from most to least verbose:
# debug, info, notice, warning, error.
# Use debug for local diagnostics, info for normal operation, and error when only failures should be recorded.
# Logs are written to var/log/app.log.
LOG_LEVEL=error

# PHP runtime switch: 1 enables OPcache, 0 disables it.
PHP_OPCACHE_ENABLED=1

# Names correspond to the directory and class in Umulmrum\Holiday\Provider.
# The "national" version selects the nationwide provider, e.g. Poland\Poland.
# For a regional variant, use e.g. HOLIDAY_COUNTRY=Germany and HOLIDAY_CALENDAR_VERSION=Bavaria.
HOLIDAY_COUNTRY=Poland
HOLIDAY_CALENDAR_VERSION=national
