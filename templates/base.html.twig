<!doctype html>
<html lang="{{ currentLocale|default('pl') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ t('app.name') }}{% endblock %}</title>
    <link rel="icon" href="{{ jiraFaviconUrl }}">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body class="template-{{ templateVariant|default('default') }}">
    <main class="container {% block container_class %}{% endblock %}">{% block content %}{% endblock %}</main>
    <script src="/js/locale.js" defer></script>
</body>
</html>
